<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FeedCustomizer.Pages.AddFeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FeedCustomizer.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 表单内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,20">
            <Border>
                <StackPanel Spacing="16">
                    <!-- 网址输入 -->
                    <TextBox 
                        x:Name="UrlTextBox" 
                        x:Uid="UrlTextBox"
                        InputScope="Url"
                        Margin="0,10,0,0"
                        Text="{x:Bind FeedViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 名称输入 -->
                    <TextBox 
                        x:Name="NameTextBox" 
                        x:Uid="NameTextBox"
                        Margin="0,0,0,0"
                        Text="{x:Bind FeedViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 图片选择器区域 -->
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="ImageSelectionHeader" Margin="0,0,0,0"/>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton
                                x:Name="WebsiteIconRadioButton"
                                x:Uid="WebsiteIconRadioButton"
                                GroupName="IconSource"
                                IsChecked="True"
                                Checked="OnIconModeChanged" />
                            <RadioButton
                                x:Name="CustomIconRadioButton"
                                x:Uid="CustomIconRadioButton"
                                GroupName="IconSource"
                                Checked="OnIconModeChanged" />
                        </StackPanel>

                        <Grid x:Name="WebsiteImageControls">
                            <Border
                                x:Name="WebsiteImagePreviewBorder"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Width="100"
                                Height="100"
                                Padding="12"
                                HorizontalAlignment="Left">
                                <Grid>
                                    <FontIcon
                                        x:Name="WebsiteDefaultIcon"
                                        Glyph="&#xE909;"
                                        FontSize="64" />
                                    <Image
                                        x:Name="WebsitePreviewImage"
                                        Source="{x:Bind FeedViewModel.BitmapImage, Mode=OneTime}"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="CustomImageControls"
                              ColumnSpacing="12"
                              RowSpacing="12"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 图片预览区域 (占位) -->
                            <Border 
                                x:Name="ImagePreviewBorder"
                                Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Width="100"
                                Height="100"
                                Padding="12"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <Grid>
                                    <FontIcon
                                        x:Name="CustomDefaultIcon"
                                        Glyph="&#xE909;"
                                        FontSize="64" />
                                    <Image
                                        Stretch="Uniform"
                                        x:Name="PreviewImage" 
                                        Source="{x:Bind FeedViewModel.BitmapImage, Mode=OneTime}" />
                                </Grid>
                            </Border>

                            <!-- 选择图片按钮 -->
                            <Button
                                x:Name="SelectImageButton"
                                Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Click="OnSelectImageButtonClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="OpenFile"/>
                                    <TextBlock x:Uid="SelectImageButton"/>
                                </StackPanel>
                            </Button>

                            <!-- 清除图片按钮 -->
                            <Button 
                                x:Name="ClearImageButton"
                                Grid.Row="1" Grid.Column="1"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind FeedViewModel.CanClearImage.Value, Mode=OneWay}"
                                Click="OnClearImageButtonClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Clear"/>
                                    <TextBlock x:Uid="ClearButton"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 底部操作栏与主页保持一致，添加页只保留右侧两个按钮。 -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,12,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="1"
                    Spacing="12"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
                    <Button
                        x:Name="CancelButton"
                        MinWidth="128"
                        HorizontalAlignment="Right"
                        Click="OnCancelButtonClick">
                        <TextBlock x:Uid="CancelButton" />
                    </Button>
                    <Button
                        x:Name="SaveButton"
                        MinWidth="128"
                        x:Uid="SaveButton"
                        HorizontalAlignment="Right"
                        IsEnabled="{x:Bind FeedViewModel.CanSave.Value, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSaveButtonClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 顶部标题 (可选) -->
        <TextBlock Grid.Row="0" 
                   Text="{x:Bind FeedViewModel.PageTitle, Mode=OneTime}" 
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="20,20,20,10"/>

    </Grid>
</Page>
