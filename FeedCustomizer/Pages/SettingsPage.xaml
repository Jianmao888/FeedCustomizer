<Page
    x:Class="FeedCustomizer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="20,20,20,0">
        <StackPanel Spacing="32">
            <StackPanel Spacing="3">
                <TextBlock x:Uid="AppearanceGroup" FontSize="14" Margin="0,0,0,6" FontWeight="SemiBold"/>

                <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="70">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE706;" Width="25" FontSize="20"/>
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock x:Uid="ThemeTitle" FontSize="14.4"/>
                                <TextBlock x:Uid="ThemeSubtitle" FontSize="12" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <RadioButtons x:Name="RbTheme" SelectionChanged="RbTheme_SelectionChanged" Padding="12,0,0,12">
                        <RadioButton x:Uid="ThemeSystem" Tag="System"/>
                        <RadioButton x:Uid="ThemeLight" Tag="Light"/>
                        <RadioButton x:Uid="ThemeDark" Tag="Dark"/>
                    </RadioButtons>
                </Expander>

                <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="70">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE2B1;" Width="25" FontSize="20"/>
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock x:Uid="MaterialTitle" FontSize="14.4"/>
                                <TextBlock x:Uid="MaterialSubtitle" FontSize="12" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <RadioButtons x:Name="RbMaterial" SelectionChanged="RbMaterial_SelectionChanged" Padding="12,0,0,12">
                        <RadioButton Content="Mica" Tag="Mica"/>
                        <RadioButton Content="Mica Alt" Tag="MicaAlt"/>
                        <RadioButton Content="Acrylic" Tag="Acrylic"/>
                    </RadioButtons>
                </Expander>
            </StackPanel>

            <StackPanel Spacing="3">
                <TextBlock x:Uid="SoundGroup" FontSize="14" Margin="0,0,0,6" FontWeight="SemiBold"/>
                <controls:SettingsCard x:Uid="Settings_SoundCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="70" Padding="16,0">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE767;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="SoundToggle" HorizontalAlignment="Right" Toggled="SoundToggle_Toggled"/>
                </controls:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="3">
                <TextBlock x:Uid="AdvancedGroup" FontSize="14" Margin="0,0,0,6" FontWeight="SemiBold"/>
                <controls:SettingsCard x:Uid="Settings_AutoDeveloperModeCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="70" Padding="16,0">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7EF;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AutoDeveloperModeToggle" HorizontalAlignment="Right" Toggled="AutoDeveloperModeToggle_Toggled"/>
                </controls:SettingsCard>
                <controls:SettingsCard x:Uid="Settings_RegionPolicyCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="70" Padding="16,0">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button x:Name="UnlockRegionPolicyButton" x:Uid="UnlockRegionPolicyButton" HorizontalAlignment="Right" Click="UnlockRegionPolicyButton_Click"/>
                </controls:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="3">
                <TextBlock x:Uid="DonationGroup" FontSize="14" Margin="0,0,0,6" FontWeight="SemiBold"/>
                <controls:SettingsCard x:Uid="DonationCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="70" Padding="16,0">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE00B;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="DonateButton" x:Uid="DonateButton" Style="{StaticResource AccentButtonStyle}" Click="DonateButton_Click"/>
                        <StackPanel x:Name="DonationThanksPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE73E;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="DonationThanks" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="3">
                <TextBlock x:Uid="AboutGroup" FontSize="14" Margin="0,0,0,6" FontWeight="SemiBold"/>
                <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="70">
                    <Expander.Header>
                        <Grid HorizontalAlignment="Stretch" Margin="1,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="ImgAppIcon" Grid.Column="0" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Source="{x:Bind AboutViewModel.AppLogoImage}" />
                            <StackPanel Grid.Column="1" Margin="21,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAppName" FontSize="14.4"/>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock x:Name="TxtCopyrightPrefix" Padding="0" FontSize="12" Opacity="0.8" Text="{x:Bind AboutViewModel.GetCopyrightPrefix()}" />
                                    <HyperlinkButton
                                        Content="{x:Bind AboutViewModel.Developer1Name}"
                                        Tag="{x:Bind AboutViewModel.Developer1Link}"
                                        Click="DeveloperLink_Click"
                                        Padding="5,0,0,0"
                                        FontSize="12"
                                        Opacity="0.7">
                                        <HyperlinkButton.RenderTransform>
                                            <TranslateTransform Y="-1" />
                                        </HyperlinkButton.RenderTransform>
                                    </HyperlinkButton>
                                    <TextBlock Text=" , " FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                    <HyperlinkButton
                                        Content="{x:Bind AboutViewModel.Developer2Name}"
                                        Tag="{x:Bind AboutViewModel.Developer2Link}"
                                        Click="DeveloperLink_Click"
                                        Padding="0,0,2,0"
                                        FontSize="12"
                                        Opacity="0.7">
                                        <HyperlinkButton.RenderTransform>
                                            <TranslateTransform Y="-1" />
                                        </HyperlinkButton.RenderTransform>
                                    </HyperlinkButton>
                                    <TextBlock x:Uid="AboutCopyrightAllRights" FontSize="12" Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="TxtVersion" Grid.Column="2" FontSize="14.4" Opacity="0.7" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <StackPanel>
                            <TextBlock x:Uid="AboutOpenSourceLink" FontSize="13" Opacity="0.6"/>
                            <HyperlinkButton Content="Gitee" Click="OpenSourceLink_Click" Padding="0" FontSize="16"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
