<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FeedCustomizer.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FeedCustomizer"
    xmlns:views="using:FeedCustomizer.Pages"
    xmlns:view_models="using:FeedCustomizer.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="MainPage_Loaded">

    <Page.Resources>
        <DataTemplate x:Key="FeedItemTemplate" x:DataType="view_models:FeedViewModel">
            <controls:SettingsCard
                Header="{x:Bind Name, Mode=OneWay}"
                Description="{x:Bind Url, Mode=OneWay}"
                Padding="12,0"
                ContentAlignment="Right"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Right">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="{x:Bind BitmapImage, Mode=OneTime}" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <HyperlinkButton
                            Grid.Column="0"
                            x:Uid="EditFeedButton"
                            Click="OnEditFeedButtonClicked"
                            DataContext="{x:Bind}"
                            Padding="0">
                        </HyperlinkButton>
                        <HyperlinkButton
                            Grid.Column="1"
                            x:Uid="DeleteFeedButton"
                            Click="OnDeleteFeedButtonClicked"
                            DataContext="{x:Bind}"
                            Padding="0">
                        </HyperlinkButton>
                    </Grid>
                </controls:SettingsCard.Content>
            </controls:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 设备设置区域提示横幅：自动高度 -->
            <RowDefinition Height="Auto" />
            <!-- 设置列表区域：占据剩余所有空间 -->
            <RowDefinition Height="*" />
            <!-- 底部按钮栏：自动高度，带分隔线 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 设备设置区域非欧盟成员国时的提示横幅 -->
        <InfoBar
            x:Name="RegionWarningInfoBar"
            Grid.Row="0"
            x:Uid="RegionWarningInfoBar"
            Margin="12,12,12,0"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsRegionWarningVisible, Mode=TwoWay}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <HyperlinkButton
                    x:Uid="RegionWarningUnlockButton"
                    Command="{x:Bind ViewModel.UnlockRegionPolicyCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- 整体内容区域 -->
        <Border
            Grid.Row="1"
            Padding="12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:SettingsCard
                    Grid.Row="0"
                    x:Uid="EnableCustomizerCard"
                    MinHeight="70"
                    Padding="16,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ToggleSwitch
                        x:Uid="FeedProviderToggle"
                        HorizontalAlignment="Right"
                        IsEnabled="{x:Bind ViewModel.IsButtonsEnabled, Mode=OneWay}"
                        AutomationProperties.Name="EnableFeedToggle"
                        Toggled="OnFeedProviderToggleChanged"
                        IsOn="{x:Bind ViewModel.IsFeedProviderEnabled, Mode=TwoWay}"/>
                </controls:SettingsCard>

                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <!-- 源列表设置展开器，列表内容由嵌套 SettingsCard 承载 -->
                    <controls:SettingsExpander
                        x:Name="FeedSettingsExpander"
                        x:Uid="FeedListExpander"
                        IsExpanded="True"
                        ItemsSource="{x:Bind ViewModel.Feeds}"
                        ItemTemplate="{StaticResource FeedItemTemplate}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">
                        <controls:SettingsExpander.Content>
                            <Button
                                x:Uid="FeedListAddButton"
                                Padding="0"
                                Height="32"
                                Margin="0,0,16,0"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.IsButtonsEnabled, Mode=OneWay}"
                                Command="{x:Bind ViewModel.AddFeedCommand}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Padding="11,0">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            Glyph="&#xE710;"
                                            FontSize="16" />
                                        <TextBlock
                                            x:Uid="AddFeedButton"
                                            FontSize="14"
                                            Padding="0,5,0,6"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </controls:SettingsExpander.Content>
                    </controls:SettingsExpander>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部按钮部分 -->
        <Border 
            Grid.Row="2"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,12,12,12">
            <Grid>
                <!-- 定义两列：左侧列容纳两个按钮，右侧列容纳一个按钮 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧的 StackPanel，用于垂直排列两个按钮 -->
                <!-- StackPanel 被放置在第一列 (Grid.Column="0") -->
                <StackPanel 
                    Grid.Column="0" 
                    Spacing="8" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">
                    <HyperlinkButton Padding="6" x:Uid="GetHelpButton" Command="{x:Bind ViewModel.GetHelpCommand}">
                        <FontIcon Glyph="&#xE82F;" FontSize="16"/>
                    </HyperlinkButton>
                    <HyperlinkButton Padding="6" x:Uid="AboutButton" Command="{x:Bind ViewModel.AboutCommand}">
                        <FontIcon Glyph="&#xE713;" FontSize="16"/>
                    </HyperlinkButton>
                </StackPanel>

                <!-- 右侧的按钮，被放置在第二列 (Grid.Column="1") -->
                <StackPanel
                    Grid.Column="1" 
                    Spacing="12"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
                    <Button
                        x:Name="CancelChangesButton"
                        x:Load="{x:Bind ViewModel.IsApplyButtonEnabled, Mode=OneWay}"
                        MinWidth="128"
                        HorizontalAlignment="Right"
                        IsEnabled="{x:Bind ViewModel.IsApplyButtonEnabled, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelChangesCommand}">
                        <TextBlock x:Uid="CancelButton" />
                    </Button>
                    <Button
                        x:Name="ApplyButton"
                        MinWidth="128"
                        x:Uid="ApplyButton"
                        HorizontalAlignment="Right"
                        IsEnabled="{x:Bind ViewModel.IsApplyButtonEnabled, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ApplyFeedsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
